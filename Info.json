{
  "name": "iina-sub",
  "identifier": "io.github.xinmin.iina-sub",
  "version": "2.1.1",
  "description": "Local AI subtitles for IINA. Transcribe local videos with whisper.cpp, mlx-whisper or any custom command. Native subtitle tracks, smart caching, batch transcription and a Chinese interface.",
  "author": {
    "name": "xinmin",
    "email": "wxmpro@outlook.com",
    "url": "https://github.com/wxmpro"
  },
  "entry": "main.js",
  "preferencesPage": "pref.html",
  "sidebarTab": {
    "name": "iina-sub"
  },
  "preferenceDefaults": {
    "engineId": "whisper-cpp",
    "enginePath": "",
    "whisperPath": "/opt/homebrew/bin/whisper-cli",
    "modelPath": "",
    "language": "zh",
    "subtitleScript": "simplified",
    "uiLanguage": "auto",
    "chunkSeconds": "30",
    "tailSeconds": "2",
    "proxy": "",
    "autoLoad": true,
    "autoTranscribe": true
  },
  "permissions": [
    "file-system",
    "show-osd",
    "show-alert",
    "network-request"
  ]
}
